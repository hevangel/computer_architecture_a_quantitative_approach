{
  "title": "Computer Architecture: A Quantitative Approach",
  "eyebrow": "Hardware examples · SystemVerilog + VHDL",
  "description": "Browse 33 original hardware examples accompanying editions 1–7 of Hennessy and Patterson’s textbook. Each example includes a guide, two HDL implementations, and self-checking testbenches.",
  "labels": {
    "skip": "Skip to content",
    "navigation": "Chapters and appendices",
    "chapter": "Read the chapter guide"
  },
  "start": {
    "title": "Start here",
    "description": "Install Python 3, Icarus Verilog 12 and GHDL 4.x, then run these commands from this textbook repository. The browser links below open guides and source files; simulations run locally.",
    "commands": [
      "make list                    # discover the examples",
      "make test                    # run both HDL test suites",
      "make test T=set_assoc_cache   # run one example",
      "make test-sv                 # SystemVerilog only",
      "make test-vhdl               # VHDL only"
    ]
  },
